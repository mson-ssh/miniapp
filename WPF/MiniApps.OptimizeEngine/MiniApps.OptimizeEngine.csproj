<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MiniApps.OptimizeEngine</AssemblyName>
    <RootNamespace>MiniApps.OptimizeEngine</RootNamespace>
    <Version>0.3.7</Version>
    <PayloadPath>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\MiniApps.OptimizePayload.zip</PayloadPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="MiniApps.OptimizeEngine.Payload.zip" />
  </ItemGroup>
  <Target Name="BuildOptimizePayload" BeforeTargets="PrepareResources">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build-Payload.ps1&quot; -ProjectRoot &quot;$(MSBuildProjectDirectory)\..&quot; -OutputPath &quot;$(PayloadPath)&quot;" />
  </Target>
</Project>
