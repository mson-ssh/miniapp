<UserControl x:Class="MiniApps.InformationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="InfoValue" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="#29313B"/>
      <Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>
    <Style x:Key="InfoLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#737B86"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,1,18,0"/>
    </Style>
    <Style x:Key="InfoRow" TargetType="Border">
      <Setter Property="Padding" Value="20,8"/><Setter Property="BorderBrush" Value="#F0F1F3"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style x:Key="SectionHeader" TargetType="Border">
      <Setter Property="Background" Value="#F7F8FA"/><Setter Property="Padding" Value="20,9"/>
      <Setter Property="BorderBrush" Value="#E8EBEF"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#535D6B"/>
    </Style>

    <Style x:Key="TableHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#7A828D"/><Setter Property="Margin" Value="0,0,8,7"/></Style>
    <Style x:Key="TableValue" TargetType="TextBox" BasedOn="{StaticResource InfoValue}"><Setter Property="Margin" Value="0,0,8,0"/></Style>
    <DataTemplate x:Key="PlainHardware"><TextBox Text="{Binding Value, Mode=OneWay}" Style="{StaticResource InfoValue}"/></DataTemplate>
    <DataTemplate x:Key="RamHardware">
      <StackPanel>
        <TextBox Text="{Binding RamSummary, Mode=OneWay}" Style="{StaticResource InfoValue}" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <!-- Columns hug their content and share widths across rows, so the values sit close yet stay aligned. -->
        <ItemsControl x:Name="RamRows" ItemsSource="{Binding RamDisplayRows}" Grid.IsSharedSizeScope="True"><ItemsControl.ItemTemplate><DataTemplate>
          <Border Padding="0,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="RamSlot"/><ColumnDefinition Width="Auto" SharedSizeGroup="RamType"/><ColumnDefinition Width="Auto" SharedSizeGroup="RamCapacity"/><ColumnDefinition Width="Auto" SharedSizeGroup="RamMaker"/><ColumnDefinition Width="Auto" SharedSizeGroup="RamSpeed"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding Slot, Mode=OneWay}" Style="{StaticResource InfoValue}" Foreground="#737B86" Margin="0,0,24,0"/>
            <TextBox Grid.Column="1" Text="{Binding Type, Mode=OneWay}" Style="{StaticResource InfoValue}" Margin="0,0,24,0"/>
            <TextBox Grid.Column="2" Text="{Binding Capacity, Mode=OneWay}" Style="{StaticResource InfoValue}" Margin="0,0,24,0"/>
            <TextBox Grid.Column="3" Text="{Binding Manufacturer, Mode=OneWay}" Style="{StaticResource InfoValue}" Margin="0,0,24,0"/>
            <TextBox Grid.Column="4" Text="{Binding Speed, Mode=OneWay}" Style="{StaticResource InfoValue}"/>
          </Grid></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="—"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Ram.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="GpuHardware">
      <StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="90"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
          <TextBlock Text="Card đồ họa" Style="{StaticResource TableHeading}"/><TextBlock Grid.Column="1" Text="Loại" Style="{StaticResource TableHeading}"/><TextBlock Grid.Column="2" Text="VRAM" Style="{StaticResource TableHeading}"/><TextBlock Grid.Column="3" Text="Công suất" Style="{StaticResource TableHeading}"/>
        </Grid>
        <ItemsControl ItemsSource="{Binding Gpu}"><ItemsControl.ItemTemplate><DataTemplate>
          <Border BorderBrush="#EEF0F3" BorderThickness="0,1,0,0" Padding="0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="90"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding Name, Mode=OneWay}" Style="{StaticResource TableValue}"/><TextBox Grid.Column="1" Text="{Binding Kind, Mode=OneWay}" Style="{StaticResource TableValue}"/><TextBox Grid.Column="2" Text="{Binding Memory, Mode=OneWay}" Style="{StaticResource TableValue}"/><TextBox Grid.Column="3" Text="{Binding Power, Mode=OneWay}" Style="{StaticResource TableValue}"/>
          </Grid></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="—"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Gpu.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Information" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Thông số hệ thống" Foreground="#7A828D" FontSize="13" Margin="0,6,0,0"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="CopyButton" Content="Sao chép" Click="CopyInformation" IsEnabled="False" Padding="14,8" Background="Transparent" Margin="0,0,6,0" Visibility="Collapsed"/>
        <Button x:Name="RefreshButton" Click="RefreshInformation" Width="34" Height="34" Padding="0" ToolTip="Làm mới thông tin" AutomationProperties.Name="Làm mới thông tin">
          <Path Data="M 17,7 A 7,7 0 1 0 18,13 M 17,2 L 17,7 L 12,7" Stroke="#535D6B" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="19" Height="19" Stretch="Uniform"/>
        </Button>
      </StackPanel>
    </Grid>
    <ScrollViewer x:Name="InformationScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
      <StackPanel x:Name="InformationContent" Visibility="Collapsed">
        <Border Background="White" BorderBrush="#DFE3E8" BorderThickness="1" CornerRadius="5" Padding="0,4,0,0">
          <StackPanel>
            <Border Style="{StaticResource SectionHeader}"><TextBlock Text="HỆ THỐNG" Style="{StaticResource SectionTitle}"/></Border>
            <Border Style="{StaticResource InfoRow}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Windows" Style="{StaticResource InfoLabel}"/>
                <Grid Grid.Column="1" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox Text="{Binding [Windows], Mode=OneWay}" Style="{StaticResource InfoValue}"/>
                  <Ellipse Grid.Column="1" Width="8" Height="8" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{Binding [Bản quyền Windows]}" AutomationProperties.Name="{Binding [Bản quyền Windows]}">
                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#D9A514"/><Style.Triggers><DataTrigger Binding="{Binding [Bản quyền Windows]}" Value="Đã kích hoạt"><Setter Property="Fill" Value="#32A65A"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                  </Ellipse>
                </Grid>
                <TextBlock Grid.Column="3" Text="Host" Style="{StaticResource InfoLabel}"/>
                <TextBox Grid.Column="4" Text="{Binding [Tên máy], Mode=OneWay}" Style="{StaticResource InfoValue}"/>
              </Grid>
            </Border>
            <Border Style="{StaticResource InfoRow}" BorderThickness="0">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Model" Style="{StaticResource InfoLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding [Model], Mode=OneWay}" Style="{StaticResource InfoValue}"/>
                <TextBlock Grid.Column="3" Text="Serial" Style="{StaticResource InfoLabel}"/>
                <Grid Grid.Column="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox Text="{Binding [Serial], Mode=OneWay}" Style="{StaticResource InfoValue}" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <Button x:Name="DriverButton" Grid.Column="1" Content="Driver" Click="OpenDriver" Padding="10,5" VerticalAlignment="Center" IsEnabled="False" ToolTip="Sao chép Serial và mở trang hỗ trợ driver chính thức"/>
                </Grid>
              </Grid>
            </Border>
            <Border Style="{StaticResource SectionHeader}" BorderThickness="0,1,0,1"><TextBlock Text="PHẦN CỨNG" Style="{StaticResource SectionTitle}"/></Border>
            <ItemsControl x:Name="InformationList">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border Style="{StaticResource InfoRow}">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource InfoLabel}"><Setter Property="Text" Value="{Binding Name}"/><Style.Triggers><DataTrigger Binding="{Binding Name}" Value="Graphics Card"><Setter Property="Text" Value="GPU"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    <ContentControl Grid.Column="1" Content="{Binding}"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{StaticResource PlainHardware}"/><Style.Triggers><DataTrigger Binding="{Binding Name}" Value="RAM"><Setter Property="ContentTemplate" Value="{StaticResource RamHardware}"/></DataTrigger><DataTrigger Binding="{Binding Name}" Value="Graphics Card"><Setter Property="ContentTemplate" Value="{StaticResource GpuHardware}"/></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl>
                  </Grid>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource InfoRow}" BorderThickness="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Ổ đĩa" Style="{StaticResource InfoLabel}"/><StackPanel Grid.Column="1">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="85"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Text="Model" Style="{StaticResource TableHeading}"/><TextBlock Grid.Column="1" Text="Dung lượng" Style="{StaticResource TableHeading}"/><TextBlock Grid.Column="2" Text="Kết nối" Style="{StaticResource TableHeading}"/></Grid>
              <ItemsControl x:Name="StorageList"><ItemsControl.ItemTemplate><DataTemplate>
                <Border BorderBrush="#E7EAEF" BorderThickness="0,1,0,0" Padding="0,10"><StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="85"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBox Text="{Binding Model, Mode=OneWay}" Style="{StaticResource TableValue}" FontWeight="SemiBold"/><TextBox Grid.Column="1" Text="{Binding Capacity, Mode=OneWay}" Style="{StaticResource TableValue}"/><TextBox Grid.Column="2" Text="{Binding Connection, Mode=OneWay}" Style="{StaticResource TableValue}"/></Grid>
                  <ItemsControl ItemsSource="{Binding Partitions}" Margin="0,5,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                    <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Letter, StringFormat={}{0}:}" FontSize="13" Foreground="#667180" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1"><TextBlock Text="{Binding CapacityText}" FontSize="12" Foreground="#667180" Margin="0,0,0,5"/>
                        <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="3" BorderThickness="0" Background="#E9ECF0" Foreground="#869AAD" Visibility="{Binding HasCapacity, Converter={StaticResource BoolVisibility}}" ToolTip="Tỷ lệ dung lượng đã sử dụng"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel></Border>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <TextBlock Text="—"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=StorageList}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </StackPanel></Grid></Border>
            <Border Style="{StaticResource SectionHeader}" BorderThickness="0,1,0,1"><TextBlock Text="MÀN HÌNH" Style="{StaticResource SectionTitle}"/></Border>
            <Border Style="{StaticResource InfoRow}" BorderThickness="0" ToolTip="Mức cao nhất Windows báo cho màn hình chính theo kết nối hiện tại. Hai mức tối đa có thể thuộc hai chế độ hiển thị khác nhau.">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="135"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Độ phân giải tối đa" Style="{StaticResource InfoLabel}" Margin="0,1,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding [Độ phân giải], Mode=OneWay}" Style="{StaticResource InfoValue}"/>
                <TextBlock Grid.Column="3" Text="Tần số quét tối đa" Style="{StaticResource InfoLabel}" Margin="0,1,8,0"/>
                <TextBox Grid.Column="4" Text="{Binding [Tần số quét tối đa], Mode=OneWay}" Style="{StaticResource InfoValue}"/>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding [Thời điểm đọc], StringFormat=Thời điểm đọc: {0}}" Foreground="#8B929B" FontSize="12" Margin="1,10,0,2"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel x:Name="LoadingPanel" Grid.Row="1" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
      <TextBlock x:Name="LoadingPercent" Text="1%" FontSize="48" FontWeight="SemiBold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
      <ProgressBar x:Name="LoadingProgress" Minimum="0" Maximum="100" Value="1" Height="6" BorderThickness="0" Background="#E3E8EE" Foreground="{StaticResource Accent}" Margin="0,14,0,14"/>
      <TextBlock Text="Đang đọc thông tin hệ thống…" FontSize="15" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="0,12,0,0">
      <TextBlock x:Name="StatusText" Text="Chọn Information để đọc thông tin máy." Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap"/>
    </StackPanel>
  </Grid>
</UserControl>
