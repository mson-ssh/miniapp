<UserControl x:Class="MiniApps.InformationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <SolidColorBrush x:Key="InfoText" Color="#1F2630"/>
    <SolidColorBrush x:Key="InfoMuted" Color="#7B8490"/>
    <SolidColorBrush x:Key="InfoRule" Color="#ECEEF1"/>
    <!-- Values are read-only text boxes so any figure can be selected and copied. -->
    <Style x:Key="InfoValue" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="{StaticResource InfoText}"/>
      <Setter Property="FontSize" Value="15"/><Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>
    <Style x:Key="InfoLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource InfoMuted}"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="0,1,16,0"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Information" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Thông số hệ thống" Foreground="#7A828D" FontSize="13" Margin="0,6,0,0"/></StackPanel>
      <Button x:Name="RefreshButton" Grid.Column="1" VerticalAlignment="Center" Click="RefreshInformation" Width="34" Height="34" Padding="0" ToolTip="Làm mới thông tin" AutomationProperties.Name="Làm mới thông tin">
        <Path Data="M 17,7 A 7,7 0 1 0 18,13 M 17,2 L 17,7 L 12,7" Stroke="#535D6B" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="19" Height="19" Stretch="Uniform"/>
      </Button>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
      <StackPanel x:Name="InformationContent" Visibility="Collapsed">
        <!-- Device: the host name, and the serial the driver search needs. -->
        <TextBox x:Name="DeviceHeading" Text="{Binding Host, Mode=OneWay, StringFormat=HOST · {0}}" Style="{StaticResource InfoValue}" FontSize="24" FontWeight="SemiBold" Margin="-2,0,0,0"/>
        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="Serial" Style="{StaticResource InfoLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBox Grid.Column="1" Text="{Binding Serial, Mode=OneWay}" Style="{StaticResource InfoValue}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" AutomationProperties.Name="Serial máy"/>
          <Button x:Name="DriverButton" Grid.Column="2" Content="Driver" Click="OpenDriver" Padding="12,4" HorizontalAlignment="Left" VerticalAlignment="Center" IsEnabled="False" ToolTip="Sao chép Serial và mở trang hỗ trợ driver chính thức"/>
        </Grid>
        <Border BorderBrush="{StaticResource InfoRule}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,14,0,0">
          <StackPanel>
            <TextBlock Text="Hệ điều hành" FontSize="15" FontWeight="SemiBold" Foreground="#3A4350" Margin="0,0,0,10"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="Phiên bản" Style="{StaticResource InfoLabel}" Margin="0,1,16,8"/>
              <TextBox x:Name="WindowsValue" Grid.Column="1" Text="{Binding Windows, Mode=OneWay}" Style="{StaticResource InfoValue}" Margin="0,0,0,8"/>
              <TextBlock Grid.Row="1" Text="Bản quyền" Style="{StaticResource InfoLabel}" Margin="0,1,16,8"/>
              <!-- Colour only where it tells the technician something: Windows not confirmed as activated. -->
              <TextBox x:Name="ActivationValue" Grid.Row="1" Grid.Column="1" Text="{Binding Activation, Mode=OneWay}" Margin="0,0,0,8">
                <TextBox.Style>
                  <Style TargetType="TextBox" BasedOn="{StaticResource InfoValue}">
                    <Style.Triggers><DataTrigger Binding="{Binding Activated}" Value="False"><Setter Property="Foreground" Value="#B7791F"/></DataTrigger></Style.Triggers>
                  </Style>
                </TextBox.Style>
              </TextBox>
            </Grid>
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding ReadAt, StringFormat=Thời điểm đọc: {0}}" Foreground="#9AA1AA" FontSize="13" Margin="0,8,0,2"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,12,0,0">
      <TextBlock x:Name="StatusText" Text="Chọn Information để đọc thông tin máy." Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap"/>
    </StackPanel>
  </Grid>
</UserControl>
