<UserControl x:Class="MiniApps.InformationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <SolidColorBrush x:Key="InfoText" Color="#1F2630"/>
    <SolidColorBrush x:Key="InfoMuted" Color="#7B8490"/>
    <SolidColorBrush x:Key="InfoRule" Color="#ECEEF1"/>
    <!-- Values are read-only text boxes so any figure can be selected and copied. -->
    <Style x:Key="InfoValue" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="{StaticResource InfoText}"/>
      <Setter Property="FontSize" Value="15"/><Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>
    <Style x:Key="InfoLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource InfoMuted}"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="0,1,16,0"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- Colour only where it tells the technician something: Windows not confirmed as activated. -->
    <Style x:Key="ToneValue" TargetType="TextBox" BasedOn="{StaticResource InfoValue}">
      <Style.Triggers><DataTrigger Binding="{Binding Tone}" Value="warn"><Setter Property="Foreground" Value="#B7791F"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="DetailValue" TargetType="TextBox" BasedOn="{StaticResource InfoValue}">
      <Setter Property="Foreground" Value="#5F6875"/><Setter Property="FontSize" Value="14"/>
      <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
    </Style>
    <!-- A section: its title, short label/value lines, then components (name, one line of specifications, disk volumes). -->
    <DataTemplate x:Key="SectionTemplate">
      <Border BorderBrush="{StaticResource InfoRule}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,14,0,0">
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#3A4350" Margin="0,0,0,10"/>
          <!-- Labels share one width per section: as wide as the longest label, so values sit close to them. -->
          <ItemsControl ItemsSource="{Binding Facts}" Grid.IsSharedSizeScope="True">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="FactLabel"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource InfoLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource ToneValue}"/>
              </Grid>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <StackPanel Margin="0,0,0,10">
                <TextBox Text="{Binding Title, Mode=OneWay}" Style="{StaticResource InfoValue}" FontWeight="Medium"/>
                <TextBox Text="{Binding Detail, Mode=OneWay}" Style="{StaticResource DetailValue}" Margin="0,2,0,0"/>
                <ItemsControl ItemsSource="{Binding Partitions}" Margin="0,2,0,0">
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Grid Margin="0,6,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Letter, StringFormat={}{0}:}" FontSize="14" Foreground="{StaticResource InfoMuted}" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding CapacityText}" FontSize="13" Foreground="{StaticResource InfoMuted}" Margin="0,0,0,4"/>
                        <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="3" BorderThickness="0" Background="#EDEFF2" Foreground="#8C9AAA" Visibility="{Binding HasCapacity, Converter={StaticResource BoolVisibility}}" ToolTip="Tỷ lệ dung lượng đã sử dụng"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Information" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Thông số hệ thống" Foreground="#7A828D" FontSize="13" Margin="0,6,0,0"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="CopyButton" Content="Sao chép" Click="CopyInformation" IsEnabled="False" Padding="14,8" Background="Transparent" Margin="0,0,6,0" Visibility="Collapsed"/>
        <Button x:Name="RefreshButton" Click="RefreshInformation" Width="34" Height="34" Padding="0" ToolTip="Làm mới thông tin" AutomationProperties.Name="Làm mới thông tin">
          <Path Data="M 17,7 A 7,7 0 1 0 18,13 M 17,2 L 17,7 L 12,7" Stroke="#535D6B" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="19" Height="19" Stretch="Uniform"/>
        </Button>
      </StackPanel>
    </Grid>
    <ScrollViewer x:Name="InformationScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
      <StackPanel x:Name="InformationContent" Visibility="Collapsed">
        <!-- Device: what the machine is, who made it, and the serial the driver search needs. -->
        <TextBox Text="{Binding Model, Mode=OneWay}" Style="{StaticResource InfoValue}" FontSize="24" FontWeight="SemiBold" Margin="-2,0,0,0"/>
        <TextBlock Text="{Binding Maker}" Foreground="{StaticResource InfoMuted}" FontSize="14" Margin="0,4,0,0"/>
        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="Serial" Style="{StaticResource InfoLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBox Grid.Column="1" Text="{Binding Serial, Mode=OneWay}" Style="{StaticResource InfoValue}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" AutomationProperties.Name="Serial máy"/>
          <Button x:Name="DriverButton" Grid.Column="2" Content="Driver" Click="OpenDriver" Padding="12,4" HorizontalAlignment="Left" VerticalAlignment="Center" IsEnabled="False" ToolTip="Sao chép Serial và mở trang hỗ trợ driver chính thức"/>
        </Grid>
        <!-- Two columns: the machine itself on the left, graphics, storage and display on the right. -->
        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <ItemsControl x:Name="LeftSections" ItemsSource="{Binding LeftSections}" ItemTemplate="{StaticResource SectionTemplate}" VerticalAlignment="Top"/>
          <ItemsControl x:Name="RightSections" Grid.Column="2" ItemsSource="{Binding RightSections}" ItemTemplate="{StaticResource SectionTemplate}" VerticalAlignment="Top"/>
        </Grid>
        <TextBlock Text="{Binding ReadAt, StringFormat=Thời điểm đọc: {0}}" Foreground="#9AA1AA" FontSize="13" Margin="0,8,0,2"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel x:Name="LoadingPanel" Grid.Row="1" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
      <TextBlock x:Name="LoadingPercent" Text="1%" FontSize="48" FontWeight="SemiBold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
      <ProgressBar x:Name="LoadingProgress" Minimum="0" Maximum="100" Value="1" Height="6" BorderThickness="0" Background="#E3E8EE" Foreground="{StaticResource Accent}" Margin="0,14,0,14"/>
      <TextBlock Text="Đang đọc thông tin hệ thống…" FontSize="15" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="0,12,0,0">
      <TextBlock x:Name="StatusText" Text="Chọn Information để đọc thông tin máy." Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap"/>
    </StackPanel>
  </Grid>
</UserControl>
