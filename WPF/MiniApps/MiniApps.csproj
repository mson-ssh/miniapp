<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Built by tool/AppIcon/New-AppIcon.ps1. -->
    <ApplicationIcon>MiniApps.ico</ApplicationIcon>
    <AssemblyName>MiniApps</AssemblyName>
    <Version>0.3.8</Version>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="MiniApps.ico" />
    <Content Include="Scripts\Configure-Windows.ps1" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Scripts\Update-Winget.ps1;Scripts\Invoke-Win11Debloat.ps1;Scripts\Install-CppEnvironment.ps1;Scripts\Enable-Smb.ps1;Scripts\Split-Disk.ps1;Scripts\Remove-Office.ps1" />
    <EmbeddedResource Include="..\tool\Share LAN\Share-LAN.ps1" LogicalName="MiniApps.Scripts.Share-LAN.ps1" />
  </ItemGroup>
</Project>
