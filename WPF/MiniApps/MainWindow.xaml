<Window x:Class="MiniApps.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniApps" Width="1120" Height="810" MinWidth="940" MinHeight="660" WindowStartupLocation="CenterScreen"
        Background="#F3F4F6" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" Closing="OnClosing">
  <Grid Background="#F3F4F6">
    <Grid.ColumnDefinitions><ColumnDefinition Width="202" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="#ECEEF1" BorderBrush="#DFE3E9" BorderThickness="0,0,1,0">
      <Grid Margin="14,28,14,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="14,0,0,32"><TextBlock Text="MiniApps" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="WINDOWS SETUP" FontSize="10" Foreground="{StaticResource Muted}" Margin="1,7,0,0" /></StackPanel>
        <ListBox x:Name="NavigationList" Grid.Row="1" SelectedIndex="{Binding Page}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Điều hướng">
          <ListBox.Resources><Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,13" /><Setter Property="Margin" Value="0,3" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Row" CornerRadius="5" Background="Transparent"><Grid>
                <Border x:Name="Mark" Width="3" Height="18" Background="Transparent" HorizontalAlignment="Left" CornerRadius="2" />
                <ContentPresenter Margin="{TemplateBinding Padding}" />
              </Grid></Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#DFE6EF" /><Setter TargetName="Mark" Property="Background" Value="{StaticResource Accent}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Opacity" Value="0.75" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent}" /><Setter TargetName="Row" Property="BorderThickness" Value="1" /></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
          </Style></ListBox.Resources>
          <ListBoxItem Content="Install Software" />
          <ListBoxItem Content="Driver" />
        </ListBox>
        <StackPanel Grid.Row="2" Margin="14,0,0,0"><TextBlock Text="Gọn nhẹ. Sẵn sàng." FontSize="12" Foreground="{StaticResource Muted}" /><TextBlock Text="{Binding RuntimeLabel}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="32,28,32,22">
      <Grid Visibility="{Binding IsInstall, Converter={StaticResource BoolVisibility}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,22"><TextBlock Text="Install Software" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="Ứng dụng cần thiết, Windows theo cách của bạn." Foreground="{StaticResource Muted}" Margin="0,7,0,0" /><TextBlock Text="{Binding Machine}" Style="{StaticResource Caption}" Margin="0,13,0,0" /></StackPanel>
        <ScrollViewer x:Name="InstallScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
          <StackPanel>
            <Border Style="{StaticResource Panel}" Visibility="{Binding IsReady, Converter={StaticResource BoolVisibility}}">
              <StackPanel>
                <TextBlock Text="Sẵn sàng cài đặt" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="Một lần bấm để cài toàn bộ ứng dụng đã cấu hình. Tiến trình từng ứng dụng sẽ xuất hiện khi bắt đầu." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,28" />
                <TextBlock Text="Khi bấm Cài đặt, bạn sẽ được hỏi chọn Office 2024 hoặc WPS." Style="{StaticResource Caption}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}" Visibility="{Binding HasStarted, Converter={StaticResource BoolVisibility}}">
              <StackPanel>
                <TextBlock Text="Tiến trình cài đặt" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18" />
                <ItemsControl ItemsSource="{Binding ProgressRows}" x:Name="ProgressList">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Border BorderBrush="#E1E5EA" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,8,8" MouseLeftButtonUp="OnProgressCardClick">
                      <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#FFFFFF" /><Style.Triggers><DataTrigger Binding="{Binding IsWindowsSummary}" Value="True"><Setter Property="Cursor" Value="Hand" /><Setter Property="Background" Value="#F7FAFE" /></DataTrigger></Style.Triggers></Style></Border.Style>
                      <Grid MinHeight="67">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,0,9" />
                        <Grid Grid.Row="1" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Margin="0,0,10,0" />
                          <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar Grid.Row="2" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsInstalling}" Height="4" BorderThickness="0" Background="#E8EBF0" Foreground="{StaticResource Accent}" />
                      </Grid>
                    </Border>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Background="#F3F5F8" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,4,8,10" Visibility="{Binding IsWindowsDetailsVisible, Converter={StaticResource BoolVisibility}}">
                  <StackPanel>
                    <TextBlock Text="Các thiết lập Windows" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding WindowsTaskDetails}" x:Name="WindowsTaskDetailsList">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="#FFFFFF" BorderBrush="#E1E5EA" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,8,8">
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            <Grid Margin="0,8,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Margin="0,0,8,0" />
                              <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0:0}%}" Style="{StaticResource Caption}" />
                            </Grid>
                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="3" BorderThickness="0" Background="#E8EBF0" Foreground="{StaticResource Accent}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <TextBlock Text="Phần trăm thể hiện tiến trình tải. Khi bộ cài không cung cấp %, MiniApps hiển thị trạng thái đang cài." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,14,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="#DDE1E7" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,12,0,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" /><TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,5,0,7" TextWrapping="Wrap" /><ProgressBar Value="{Binding Overall, Mode=OneWay}" Height="3" Background="#E0E5EB" Foreground="{StaticResource Accent}" BorderThickness="0" Margin="0,7,0,0" /></StackPanel>
            <Button Grid.Column="1" Content="Dừng hàng đợi" Command="{Binding CancelCommand}" Visibility="{Binding ShowInstallCancel, Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button Grid.Column="2" Content="{Binding InstallButtonText}" Command="{Binding InstallCommand}" Style="{StaticResource Primary}" Width="120" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </Grid>
      <Grid Visibility="{Binding IsDriver, Converter={StaticResource BoolVisibility}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,22">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Driver" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="Thông tin thiết bị và hỗ trợ driver chính hãng." Foreground="{StaticResource Muted}" Margin="0,7,0,0" /></StackPanel>
          <Button Grid.Column="1" Content="Đọc lại thông tin" Command="{Binding RefreshDriverInfoCommand}" VerticalAlignment="Center" AutomationProperties.Name="Đọc lại thông tin máy" />
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
          <StackPanel>
            <Border Style="{StaticResource Panel}" Padding="0">
              <StackPanel>
                <Border Background="#F4F7FA" BorderBrush="#E1E6EC" BorderThickness="0,0,0,1" CornerRadius="7,7,0,0" Padding="26,23">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                      <TextBlock Text="THIẾT BỊ ĐƯỢC NHẬN DIỆN" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding DriverBrand}" Foreground="{StaticResource Accent}" FontSize="14" FontWeight="SemiBold" Margin="0,15,0,4" TextTrimming="CharacterEllipsis" ToolTip="{Binding DriverBrand}" />
                      <TextBlock Text="{Binding DriverModel}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding DriverModel}" />
                      <TextBlock Text="{Binding DriverHost, StringFormat=Host: {0}}" Style="{StaticResource Caption}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding DriverHost}" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#E8F0F8" BorderBrush="#D3E1EF" BorderThickness="1" CornerRadius="12" Padding="12,5" VerticalAlignment="Top">
                      <TextBlock Text="{Binding DriverSupportLabel}" Foreground="#365A78" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                  </Grid>
                </Border>
                <Grid Margin="26,23,26,26">
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.35*" /></Grid.ColumnDefinitions>
                    <Border Background="#FAFBFC" BorderBrush="#E1E5EA" BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,0,10,0">
                      <StackPanel><TextBlock Text="Tên máy" Style="{StaticResource Caption}" /><TextBlock Text="{Binding DriverHost}" FontSize="15" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding DriverHost}" /></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#FAFBFC" BorderBrush="#E1E5EA" BorderThickness="1" CornerRadius="5" Padding="16" Margin="10,0,0,0">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0"><TextBlock Text="Serial thiết bị" Style="{StaticResource Caption}" /><TextBlock Text="{Binding DriverSerial}" FontSize="15" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding DriverSerial}" AutomationProperties.Name="Serial máy" /></StackPanel>
                        <Button Grid.Column="1" Content="Sao chép" Command="{Binding CopySerialCommand}" Padding="12,7" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </Grid>
                  <Border Grid.Row="1" Background="#F7F9FB" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="5" Padding="19" Margin="0,20,0,0">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0"><TextBlock Text="Hỗ trợ driver chính thức" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Trang hỗ trợ được xác định từ hãng sản xuất của thiết bị." Style="{StaticResource Caption}" Margin="0,6,0,0" /></StackPanel>
                        <Button Grid.Column="1" Content="Mở trang hỗ trợ" Command="{Binding OpenDriverSupportCommand}" Style="{StaticResource Primary}" VerticalAlignment="Center" />
                      </Grid>
                      <TextBlock Grid.Row="1" Text="ĐƯỜNG DẪN" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,18,0,6" />
                      <TextBox Grid.Row="2" Text="{Binding DriverUrl, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="URL tải driver" />
                    </Grid>
                  </Border>
                  <Border Grid.Row="2" Background="#EEF3F7" CornerRadius="4" Padding="12,9" Margin="0,16,0,0">
                    <TextBlock Text="{Binding DriverMessage}" Foreground="#4D5C69" TextWrapping="Wrap" />
                  </Border>
                </Grid>
              </StackPanel>
            </Border>
            <TextBlock Text="MiniApps chỉ đọc thông tin từ Windows. Dữ liệu thiết bị không được gửi lên máy chủ riêng." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,13,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
